# Orrery local environment. `make` copies this file to .env on first use and fills every empty
# secret below with a random value generated on your machine. Keys added here later are appended to
# an existing .env the same way. Do not put real production credentials in either file.
#
# Host ports are deliberately non-default so the stack does not collide with other local projects.
# Every port binds to 127.0.0.1 only.

# --- PostgreSQL 18
POSTGRES_PORT=55432
POSTGRES_USER=orrery
POSTGRES_DB=orrery
# secret: random hex, 32 bytes
POSTGRES_PASSWORD=

# --- Garage (S3 API)
GARAGE_S3_PORT=53900
GARAGE_ADMIN_PORT=53903
# Space the single local node advertises to the layout (bytes). It is a placement weight, not a quota.
GARAGE_CAPACITY_BYTES=10000000000
# secret: random hex, 32 bytes
GARAGE_RPC_SECRET=
# secret: random hex, 32 bytes
GARAGE_ADMIN_TOKEN=
# secret: random hex, 32 bytes
GARAGE_METRICS_TOKEN=
S3_BUCKET=orrery
S3_REGION=garage
# secret: Garage key ID, "GK" followed by 12 random bytes in hex
S3_ACCESS_KEY_ID=
# secret: random hex, 32 bytes
S3_SECRET_ACCESS_KEY=
# Comma-separated browser origins allowed to upload directly to the bucket (the web app's origin).
S3_CORS_ORIGINS=http://localhost:53000

# --- Mailpit (local SMTP sink with a web inbox and API)
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025

# --- OpenTelemetry Collector
OTEL_GRPC_PORT=54317
OTEL_HTTP_PORT=54318
