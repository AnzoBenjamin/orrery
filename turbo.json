{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "CI",
    "DOCKER_HOST",
    "TESTCONTAINERS_*",
    "CARGO_HOME",
    "RUSTUP_HOME",
    "UV_*"
  ],
  "tasks": {
    "codegen": {
      "dependsOn": ["^codegen"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "codegen"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "codegen"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
